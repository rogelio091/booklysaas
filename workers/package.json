{
  "name": "bookly-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml --port 8787",
    "test": "vitest run",
    "build": "wrangler deploy --config wrangler.staging.toml --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --config wrangler.staging.toml",
    "deploy:prod": "wrangler deploy --config wrangler.prod.toml",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply bookly-db-local --local --config wrangler.toml",
    "db:migrate:staging": "wrangler d1 migrations apply bookly-db-staging --remote --config wrangler.staging.toml",
    "db:migrate:prod": "wrangler d1 migrations apply bookly-db-prod --remote --config wrangler.prod.toml",
    "db:seed": "wrangler d1 execute bookly-db-local --local --config wrangler.toml --file=./src/db/seed.sql",
    "db:seed:staging": "wrangler d1 execute bookly-db-staging --remote --config wrangler.staging.toml --file=./src/db/seed.sql",
    "db:seed:prod": "wrangler d1 execute bookly-db-prod --remote --config wrangler.prod.toml --file=./src/db/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bookly/contracts": "workspace:*",
    "@hono/zod-validator": "^0.4.3",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "jose": "^5.9.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7",
    "wrangler": "^3.111.0"
  }
}
