{
  "name": "bookly-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 execute bookly-db --local --file=./src/db/migrations/0000_init.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bookly/contracts": "workspace:*",
    "@hono/zod-validator": "^0.4.3",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "jose": "^5.9.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.8.2",
    "wrangler": "^3.111.0"
  }
}
